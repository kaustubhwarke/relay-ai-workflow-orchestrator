# Copy to .env and fill in. .env is git-ignored. NEVER commit real keys.
RELAY_DB_URL=jdbc:postgresql://localhost:5432/relay
RELAY_DB_USER=relay
RELAY_DB_PASSWORD=relay
RELAY_API_TOKEN=change-me-demo-token
RELAY_MOCK_WORLD_URL=http://localhost:9210

# AI provider (any OpenAI-compatible endpoint: OpenRouter, Groq, Gemini, Ollama, OpenAI)
# Provider mode: heuristic (offline deterministic model, no key needed) | openai (real model; also needed for the NL compiler)
RELAY_AI_PROVIDER=heuristic
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
RELAY_AI_MODEL=openai/gpt-4o-mini
